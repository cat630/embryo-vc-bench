{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareSourceCode",
      "@id": "#software",
      "name": "embryo-vc-bench",
      "alternateName": "A preregistered, zero-wet-lab virtual-cell benchmark for early human embryo atlases",
      "description": "A dependency-light evaluation harness that tests whether zero-shot single-cell foundation models outperform naive baselines on surrogate in-silico perturbations built from public human preimplantation embryo atlases and on published out-of-domain CRISPRi differential-expression tables. All hypotheses, metrics, folds, seeds and falsification thresholds were preregistered on OSF before analysis. The shared latent developmental time axis was never fitted and is not claimed as a result.",
      "programmingLanguage": {
        "@type": "ComputerLanguage",
        "name": "Python",
        "version": "3.13.14",
        "url": "https://www.python.org/"
      },
      "runtimePlatform": [
        "Windows 11 (10.0.26200), AMD64, CPython 3.13.14 - environment in which all published numbers were produced",
        "Linux via release/environment/Dockerfile - portability aid, NOT CI-tested"
      ],
      "codeRepository": "https://github.com/cat630/embryo-vc-bench",
      "url": "https://github.com/cat630/embryo-vc-bench",
      "identifier": {
        "@type": "PropertyValue",
        "propertyID": "Zenodo release DOI",
        "value": "[[PENDING_ZENODO_DOI]]"
      },
      "license": "MIT",
      "version": "0.1.0-w7-draft",
      "dateCreated": "2026-11-17",
      "dateModified": "2026-11-18",
      "author": {
        "@type": "Person",
        "name": "ZHAO Mingpeng"
      },
      "isBasedOn": {
