      },
      "citation": "10.17605/OSF.IO/8TZRQ",
      "keywords": [
        "virtual cell",
        "single-cell foundation model",
        "human preimplantation embryo",
        "preregistered benchmark",
        "zero-shot evaluation",
        "negative and mixed results",
        "FAIR reproducibility"
      ],
      "hasPart": [
        "release/figure_source_data/",
        "release/environment/",
        "release/reproduce.ipynb",
        "release/RELEASE_MANIFEST.json"
      ]
    },
    {
      "@type": "Dataset",
      "@id": "#scores",
      "name": "Preregistered T2/T3 model scores, orthogonal validation artefacts and figure source data",
      "description": "Machine-readable source data for the main figure and tables: 80 preregistered model/baseline score rows, cross-atlas stratification, permutation-null audit, W4 official cell-eval DE-metric alignment and the W6 model-free data-noise ceiling computed from a deterministic seed-0 subsample. Framework-internal DES/PDS/MAE are NOT on a log2FC scale and are not numerically interchangeable with Virtual Cell Challenge leaderboard values.",
      "creator": {
        "@type": "Person",
        "name": "ZHAO Mingpeng"
      },
      "license": "MIT",
      "identifier": {
        "@type": "PropertyValue",
        "propertyID": "Zenodo release DOI",
        "value": "[[PENDING_ZENODO_DOI]]"
      },
      "isBasedOn": "https://osf.io/8tzrq/overview",
      "temporalCoverage": "2026-11-17/2026-11-18",
      "variableMeasured": [
        "MAE", "MAE_z", "DES", "PDS",
        "p_perm_DES", "p_perm_PDS", "p_adj_DES", "p_adj_PDS",
        "held_out_atlas", "seed", "overlap_at_N", "de_direction_match", "roc_auc"
      ],
      "distribution": [
